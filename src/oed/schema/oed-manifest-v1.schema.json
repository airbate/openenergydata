{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openenergydata.dev/schema/oed-manifest-v1.json",
  "title": "OpenEnergyData dataset manifest v1",
  "description": "统一规格数据集清单。顶层遵循 Croissant (MLCommons) Dataset 结构以便被主流数据集平台索引；领域扩展位于 x-oed。",
  "type": "object",
  "required": ["name", "license", "distribution", "recordSet", "x-oed"],
  "properties": {
    "@context": { "type": "string" },
    "@type": { "const": "cr:Dataset" },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "description": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "creator": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "datePublished": { "type": "string", "format": "date" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "distribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["@type", "name", "contentUrl", "encodingFormat"],
        "properties": {
          "@type": { "const": "cr:FileObject" },
          "name": { "type": "string" },
          "contentUrl": { "type": "string" },
          "encodingFormat": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentSize": { "type": "string" }
        }
      }
    },
    "recordSet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["@type", "name", "field"],
        "properties": {
          "@type": { "const": "cr:RecordSet" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "field": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["@type", "name", "dataType"],
              "properties": {
                "@type": { "const": "cr:Field" },
                "name": { "enum": ["timestamp", "power_w", "quality"] },
                "dataType": { "enum": ["sc:DateTime", "sc:Float", "sc:Integer"] },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "x-oed": {
      "type": "object",
      "required": ["spec", "source", "converter", "sites"],
      "properties": {
        "spec": { "const": "oed/1.0" },
        "source": {
          "type": "object",
          "required": ["dataset", "license"],
          "properties": {
            "dataset": { "type": "string" },
            "url": { "type": "string" },
            "license": { "type": "string" },
            "citation": { "type": "string" },
            "access_date": { "type": "string" }
          }
        },
        "converter": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "upstream": { "type": "string" }
          }
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "timezone", "channels"],
            "properties": {
              "id": { "type": "string" },
              "original_name": { "type": "string" },
              "timezone": { "type": "string" },
              "geo": {
                "type": "object",
                "properties": {
                  "country": { "type": "string" },
                  "locality": { "type": "string" },
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" }
                }
              },
              "channels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "path", "role", "physical_quantity", "ac_type", "unit", "nominal_interval_s"],
                  "properties": {
                    "id": { "type": "string" },
                    "path": { "type": "string", "pattern": "^sites/[^/]+/[^/]+\\.parquet$" },
                    "role": { "enum": ["site_meter", "submeter"] },
                    "physical_quantity": { "enum": ["power", "energy", "voltage", "current"] },
                    "ac_type": { "enum": ["active", "apparent", "reactive"] },
                    "unit": { "enum": ["W", "kW", "MW", "kWh", "MWh", "V", "A"] },
                    "nominal_interval_s": { "type": "number", "exclusiveMinimum": 0 },
                    "description": { "type": "string" },
                    "appliance": {
                      "type": ["object", "null"],
                      "properties": {
                        "type": { "type": "string" },
                        "original_name": { "type": "string" },
                        "instance": { "type": "integer" },
                        "room": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
